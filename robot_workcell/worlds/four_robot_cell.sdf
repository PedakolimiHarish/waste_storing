<?xml version="1.0"?>

<sdf version="1.10">

  <world name="four_robot_cell">

    <gravity>0 0 -9.81</gravity>

    <physics name="default_physics"
             type="ignored">

      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>

    </physics>


    <!-- ================================================= -->
    <!-- Gazebo systems                                    -->
    <!-- ================================================= -->

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics"/>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"/>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"/>


    <!-- ================================================= -->
    <!-- Ground                                             -->
    <!-- ================================================= -->

    <model name="ground">

      <static>true</static>

      <link name="ground_link">

        <collision name="collision">
          <geometry>
            <plane/>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <plane/>
          </geometry>
        </visual>

      </link>

    </model>


    <!-- ================================================= -->
    <!-- Conveyor base                                      -->
    <!-- ================================================= -->

    <model name="conveyor">

      <static>true</static>

      <pose>0 0 0 0 0 0</pose>

      <link name="conveyor_base">

        <collision name="collision">
          <pose>0 0 0.55 0 0 0</pose>
          <geometry>
            <box>
              <size>5.0 0.9 0.20</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <pose>0 0 0.55 0 0 0</pose>
          <geometry>
            <box>
              <size>5.0 0.9 0.20</size>
            </box>
          </geometry>
        </visual>


        <!-- Belt surface -->

        <collision name="belt_collision">
          <pose>0 0 0.68 0 0 0</pose>
          <geometry>
            <box>
              <size>4.7 0.76 0.06</size>
            </box>
          </geometry>
        </collision>

        <visual name="belt_visual">
          <pose>0 0 0.68 0 0 0</pose>
          <geometry>
            <box>
              <size>4.7 0.76 0.06</size>
            </box>
          </geometry>

          <material>
            <ambient>0.02 0.02 0.02 1</ambient>
            <diffuse>0.05 0.05 0.05 1</diffuse>
          </material>

        </visual>

      </link>


      <!-- Side rail +Y -->

      <link name="left_rail">

        <pose>0 0.48 0.78 0 0 0</pose>

        <collision name="collision">
          <geometry>
            <box>
              <size>5.0 0.10 0.30</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>5.0 0.10 0.30</size>
            </box>
          </geometry>
        </visual>

      </link>


      <!-- Side rail -Y -->

      <link name="right_rail">

        <pose>0 -0.48 0.78 0 0 0</pose>

        <collision name="collision">
          <geometry>
            <box>
              <size>5.0 0.10 0.30</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>5.0 0.10 0.30</size>
            </box>
          </geometry>
        </visual>

      </link>

    </model>


    <!-- ================================================= -->
    <!-- Lighting                                          -->
    <!-- ================================================= -->

    <light name="sun"
           type="directional">

      <cast_shadows>true</cast_shadows>

      <pose>0 0 6 0 0 0</pose>

      <diffuse>0.8 0.8 0.8 1</diffuse>

      <specular>0.2 0.2 0.2 1</specular>

      <direction>-0.4 -0.3 -1</direction>

    </light>

  </world>

</sdf>
