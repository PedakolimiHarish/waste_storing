<?xml version="1.0"?>

<sdf version="1.10">

  <world name="waste_sorting_cell">

    <!-- ====================================================== -->
    <!-- Physics                                                -->
    <!-- ====================================================== -->

    <gravity>0 0 -9.81</gravity>

    <physics
      name="default_physics"
      type="ignored">

      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>

    </physics>

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">

      <engine>
        <filename>gz-physics-bullet-featherstone-plugin</filename>
      </engine>

    </plugin>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"/>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"/>

    <!-- ====================================================== -->
    <!-- Sensor system                                           -->
    <!-- ====================================================== -->

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">

      <render_engine>ogre2</render_engine>

    </plugin>

    <model name="ground">
      <static>true</static>

      <link name="ground_link">

        <!-- Physical collision floor -->
        <collision name="collision">
          <geometry>
            <plane/>
          </geometry>
        </collision>

      </link>
    </model>

    <!-- Robot table -->
    <include>
      <name>table</name>
      <uri>model://Table</uri>
      <pose>0.0 0.3 -0.3 0 0 0</pose>
    </include>

    <!-- Robot plastic bin -->
    <include>
      <name>robot1_plastic_bin</name>
      <uri>model://bin_plastic</uri>
      <pose>0.55 0.5 0.7 0 0 1.5708</pose>
    </include>

    <!-- Robot metal bin -->
    <include>
      <name>robot1_metal_bin</name>
      <uri>model://bin_metal</uri>
      <pose>-0.55 0.5 0.7 0 0 1.5708</pose>
    </include>

    <!-- ====================================================== -->
    <!-- ArUco reference tags                                   -->
    <!-- ====================================================== -->

    <include>
      <name>aruco_tag_1</name>
      <uri>model://arucotag</uri>
      <pose>0.25 -0.03 0.73 0 0 0</pose>
    </include>

    <include>
      <name>aruco_tag_2</name>
      <uri>model://arucotag</uri>

      <pose>-0.25 -0.03 0.73 0 0 0</pose>
    </include>

    <include>
      <name>aruco_tag_3</name>
      <uri>model://arucotag</uri>
      <pose>-0.25 0.25 0.73 0 0 0</pose>
    </include>

    <include>
      <name>aruco_tag_4</name>
      <uri>model://arucotag</uri>
      <pose>0.25 0.25 0.73 0 0 0</pose>
    </include>

    <!-- ====================================================== -->
    <!-- Overhead sorting camera                                 -->
    <!-- ====================================================== -->

    <model name="overhead_camera">

      <static>true</static>

      <!-- Camera position in Gazebo world -->
      <pose>
        0.0 0.0 1.5
        0.0 1.57079632679 0.0
      </pose>

      <link name="camera_link">

        <sensor
          name="sorting_camera"
          type="camera">

          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>
          <topic>/sorting_camera/image</topic>

          <camera>

            <horizontal_fov>1.047</horizontal_fov>

            <image>

              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>

            </image>
            <clip>

              <near>0.05</near>
              <far>5.0</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

    <!-- ====================================================== -->
    <!-- Lighting                                                -->
    <!-- ====================================================== -->

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <direction>-0.4 -0.3 -1.0</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
    </light>

  </world>

</sdf>
