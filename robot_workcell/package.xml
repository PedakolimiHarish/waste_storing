<?xml version="1.0"?>

<package format="3">

  <name>robot_workcell</name>
  <version>0.0.1</version>

  <description>
    Four-robot waste sorting workcell for ROS 2 Jazzy and Gazebo Harmonic.
  </description>

  <maintainer email="pedakolimi.harish@gmail.com">
    Pedakolimi Harish
  </maintainer>

  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>

  <exec_depend>ur_description</exec_depend>
  <exec_depend>ur_controllers</exec_depend>
  <exec_depend>ur_simulation_gz</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
